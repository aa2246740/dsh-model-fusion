{
  "name": "dsh-model-fusion",
  "version": "0.2.2",
  "private": true,
  "description": "Fusion for DeepSeek Harness: one model entry backed by a frontier Lead that reads, briefs and reviews, and a much cheaper Sidekick that writes the code.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-model-fusion.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "fusion"
  ],
  "type": "module",
  "files": [
    "lib",
    "src",
    "prompts",
    "contracts",
    "profiles",
    "dshx.yml",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "LICENSE",
    "docs/COMPATIBILITY.md",
    "docs/EVIDENCE.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/dsh-model-fusion.d.ts",
      "import": "./lib/dsh-model-fusion.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./contracts": "./contracts/fusion.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
